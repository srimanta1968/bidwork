{
  "endpoint": "/api/projects/:id/tasks/:taskId/visibility",
  "method": "PATCH",
  "taskId": "878fa4be-77d6-452d-9a60-1305a42c7009",
  "description": "Toggle task visibility (hide/show before publishing)",
  "requiresAuth": true,
  "priority": 34,
