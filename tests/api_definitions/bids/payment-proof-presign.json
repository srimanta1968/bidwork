  "testCases": [{
    "name": "Presign payment proof",
    "headers": {"Authorization": "Bearer {{cache:auth.register.response.data.token}}"},
    "payload": {
      "filename": "payment-confirmation.pdf",
      "content_type": "application/pdf"
    },
    "expectedStatus": 200,
    "expectedResponse": {"success": true}
  }]
}
