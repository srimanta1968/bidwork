{
  "endpoint": "/api/bids/:id/payment-proof/presign",
  "method": "POST",
  "taskId": "0be54f63-6bf2-4284-9529-2d7bed7ca4b0",
  "description": "Presign S3 PUT URL for contractor payment proof document",
  "requiresAuth": true,
  "priority": 70,
  "dependsOn": ["POST /api/bids"],
  "pathParams": {
    "id": "{{cache:bids.create.response.data.bid.id}}"
